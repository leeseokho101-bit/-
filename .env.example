# 이 파일을 .env 로 복사한 뒤 값을 채우세요. 실제 값은 절대 커밋하지 않습니다.

# PostgreSQL 연결 문자열 (개발용 로컬 DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_mvp?schema=public"

# 세션 쿠키 서명용 비밀값 (32자 이상 임의 문자열). 예: openssl rand -base64 32
SESSION_SECRET=""

# LLM API Key — 서버에서만 사용합니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 비어 있으면 AI 설명 대신 템플릿 문구를 사용합니다.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-5"
