// 입체적 건강분석 — Prisma schema (docs/ARCHITECTURE.md §4)
//
// 원칙
// - 최소수집: 주민등록번호·주소·전화번호는 저장하지 않는다.
// - 입력 원본(Measurement/SurveyResponse/Medication) · 엔진 결과(AnalysisResult) · LLM 문구를 분리 저장한다.
// - 검진 지표는 (metric, value, unit, source) 행 구조로 저장해 새 지표·데이터 출처 추가 시 스키마 변경을 최소화한다.
// - 가상 사용자는 User.isSample = true 로 구분한다.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: 앱이 쓰는 연결 (Neon은 pooled 연결 문자열)
// DIRECT_URL  : 마이그레이션용 직접 연결 (Neon은 direct 연결 문자열, 로컬은 DATABASE_URL과 같게)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── 사용자 · 인증 ───────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  /// 해시만 저장 (평문 금지). 개발용 계정 로그인에만 사용.
  passwordHash   String?
  displayName    String
  /// 개발·데모용 가상 사용자 여부
  isSample       Boolean   @default(false)
  /// 개인정보·건강정보 수집 동의 시각과 동의서 버전
  consentAt      DateTime?
  consentVersion String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// 탈퇴 요청 시각 (soft delete 후 파기)
  deletedAt      DateTime?

  profile        Profile?
  sessions       Session[]
  assessments    Assessment[]
  checkupImports CheckupImport[]
  activityLogs   ActivityLog[]
  careEnrollment CareEnrollment?
  doseLogs       DoseLog[]
  glucose        GlucoseReading[]
  meals          MealLog[]
  checkIns       SymptomCheckIn[]
  careAlerts     CareAlert[]
  aiUsages       AiUsage[]
  clinicStaff    ClinicStaff?
  clinicVisits   ClinicVisit[]
  coach          Coach?
  coachMessages  CoachMessage[]
  pharmaMember   PharmaMember?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// 쿠키에는 원본 토큰, DB에는 SHA-256 해시만 저장한다.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Profile {
  userId    String   @id
  sex       Sex
  /// 연령 계산용
  birthDate DateTime @db.Date
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum Sex {
  MALE
  FEMALE
}

// ─────────────────────────────── 건강분석 입력 ───────────────────────────────

/// 한 번의 건강분석 단위. 재분석 시 새 Assessment를 만들어 변화를 추적한다.
model Assessment {
  id          String           @id @default(cuid())
  userId      String
  status      AssessmentStatus @default(DRAFT)
  checkupDate DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submittedAt DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  survey       SurveyResponse?
  medications  Medication[]
  result       AnalysisResult?
  plan         CarePlan?
  imports      CheckupImport[]

  @@index([userId, createdAt])
  @@map("assessments")
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  ANALYZED
  FAILED
}

/// 신체 계측 · 건강검진 지표
model Measurement {
  id           String     @id @default(cuid())
  assessmentId String
  metric       MetricCode
  value        Decimal    @db.Decimal(8, 2)
  /// 예: "cm", "kg", "kg/m2", "mmHg", "mg/dL", "%", "U/L", "mL/min/1.73m2"
  unit         String
  source       DataSource @default(MANUAL)
  measuredAt   DateTime?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, metric])
  @@map("measurements")
}

enum MetricCode {
  HEIGHT
  WEIGHT
  BMI
  WAIST
  SBP
  DBP
  FASTING_GLUCOSE
  HBA1C
  TOTAL_CHOLESTEROL
  LDL
  HDL
  TRIGLYCERIDE
  AST
  ALT
  GGT
  CREATININE
  EGFR
  HEMOGLOBIN
}

/// 데이터 출처. PHOTO_OCR = 결과표 사진 판독, NHIS·CHECKUP_CENTER = 외부 연동(향후), 나머지는 확장용.
enum DataSource {
  MANUAL
  PDF_OCR
  MYDATA
  WEARABLE
  PHOTO_OCR
  NHIS
  CHECKUP_CENTER
}

/// 검진 데이터 가져오기 기록 (사진 판독·외부 연동). 이미지·원본 응답은 저장하지 않는다.
/// 하루 판독 횟수 제한과 출처 추적에 사용한다.
model CheckupImport {
  id            String       @id @default(cuid())
  userId        String
  assessmentId  String?
  source        DataSource
  status        ImportStatus
  /// 판독·수신한 항목 수 (값 자체는 저장하지 않음)
  itemCount     Int          @default(0)
  /// 실패 종류 (예: "not-checkup", "refusal", "api") — 개인정보 없음
  errorKind     String?
  /// 예: "checkup-photo-v1" / 커넥터 id
  readerVersion String?
  createdAt     DateTime     @default(now())
  savedAt       DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("checkup_imports")
}

enum ImportStatus {
  /// 판독·수신 완료, 사용자 확인 전
  READ
  /// 사용자가 확인하고 저장
  SAVED
  FAILED
}

/// 건강문진 + 생활습관 응답. 문항 확장을 고려해 버전이 있는 JSON으로 저장한다.
model SurveyResponse {
  assessmentId  String   @id
  /// 예: "survey-v1" (zod 스키마 버전과 일치)
  schemaVersion String
  answers       Json
  updatedAt     DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("survey_responses")
}

/// 복용약 (자유 입력). MVP에서는 약물에 대한 판단을 하지 않는다.
model Medication {
  id           String   @id @default(cuid())
  assessmentId String
  name         String
  purpose      String?
  frequency    String?
  /// 성분·함량 카탈로그 코드 (src/domain/medication/catalog.ts). 복합제는 단일 성분으로 나눠 계산한다.
  drugCode     String?
  /// 하루 복용 알 수 (예: 1, 0.5, 2) — drugCode와 함께 하루 성분 용량 계산에 사용
  dailyTablets Decimal? @db.Decimal(4, 1)
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("medications")
}

// ─────────────────────────────── 분석 결과 ───────────────────────────────

/// Rule Engine 결과(결정적)와 LLM 설명을 분리 저장한다.
model AnalysisResult {
  assessmentId  String   @id
  /// 예: "rules-v1"
  engineVersion String
  /// 정규화된 입력의 SHA-256 — 같은 입력이면 같은 결과임을 확인하는 데 사용
  inputHash     String
  /// DomainResult[]
  domains       Json
  /// PriorityItem[] (TOP 3)
  priorities    Json
  /// 생체나이 결과 (BioAgeResult, src/domain/bio-age). 이전 분석에는 없을 수 있다.
  bioAge        Json?
  /// LLM 설명 문구. 없으면 템플릿 문구를 사용한다.
  narrative     Json?
  llmModel      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([inputHash])
  @@map("analysis_results")
}

// ─────────────────────────────── 12주 건강관리 ───────────────────────────────

model CarePlan {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  startDate    DateTime @db.Date
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  weeks      PlanWeek[]

  @@map("care_plans")
}

model PlanWeek {
  id         String    @id @default(cuid())
  planId     String
  /// 1..12
  weekNumber Int
  phase      PlanPhase
  goal       String
  /// string[]
  actions    Json
  /// { id: string, label: string }[]
  checks     Json
  /// LLM 코칭 메시지 (없으면 템플릿)
  coaching   String?

  plan     CarePlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  checkIns WeeklyCheckIn[]

  @@unique([planId, weekNumber])
  @@map("plan_weeks")
}

/// 1~4주 기초 생활습관 / 5~8주 운동·식습관 / 9~12주 유지·변화 평가
enum PlanPhase {
  FOUNDATION
  ACTIVATION
  MAINTENANCE
}

model WeeklyCheckIn {
  id        String   @id @default(cuid())
  weekId    String
  /// { [checkId]: boolean }
  completed Json
  /// 선택 입력 — "최근 변화" 표시용
  weight    Decimal? @db.Decimal(5, 1)
  note      String?
  createdAt DateTime @default(now())

  week PlanWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@index([weekId, createdAt])
  @@map("weekly_check_ins")
}

// ─────────────────────────────── 일일 활동 기록 ───────────────────────────────

/// 하루 걸음수·운동 기록 (사용자 단위, 분석과 무관하게 계속 쌓인다).
/// 운동 반영 예상 생체나이 계산에 쓴다 (src/domain/bio-age/activity.ts).
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  /// 한국 날짜
  date      DateTime @db.Date
  steps     Int?
  /// ExerciseSession[] { type, intensity, minutes }
  sessions  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("activity_logs")
}

// ─────────────────────────────── GLP-1 · CGM 대사관리 (환자 앱) ───────────────────────────────
// docs/ARCHITECTURE.md §5.8. 판정(알림 단계·위험 신호)은 src/domain/glp1 규칙만 결정한다.

/// 참여 의원. 등록 QR 카드의 연결 코드로 환자와 의원을 잇는다.
model Clinic {
  id        String   @id @default(cuid())
  /// QR 카드에 적힌 연결 코드 (예: "DEMO-0001")
  code      String   @unique
  name      String
  /// 시·도 (src/domain/pharma/regions.ts) — 제약사 포털 지역 집계용
  region    String?
  /// 개발·데모용 가상 의원 여부
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())

  enrollments CareEnrollment[]
  staff       ClinicStaff[]
  visits      ClinicVisit[]

  @@map("clinics")
}

/// 처방 동반 관리 프로그램 등록 (사용자당 1개)
model CareEnrollment {
  userId           String      @id
  clinicId         String?
  linkedAt         DateTime?
  /// 약 카탈로그 코드 (src/domain/glp1/drugs.ts)
  drugCode         String
  /// 담당 의사가 정한 현재 용량 (mg). 앱은 용량을 제안하지 않고 기록만 한다.
  currentDoseMg    Decimal     @db.Decimal(5, 2)
  /// 현재 용량을 시작한 날 (한국 날짜) — 증량 직후 안내에 사용
  doseSince        DateTime    @db.Date
  /// 첫 투약일 (한국 날짜)
  startDate        DateTime    @db.Date
  /// 항목별 동의 (서비스 이용은 필수, 나머지는 선택)
  consentVersion   String
  consentAt        DateTime
  shareWithClinic  Boolean     @default(false)
  allowResearch    Boolean     @default(false)
  allowPharmaStats Boolean     @default(false)
  /// 의원이 입력하는 값 — 다음 내원 예정일, 의원 차트번호(EMR과 맞춰 보기 위한 식별용)
  nextVisitOn      DateTime?   @db.Date
  chartNo          String?
  /// 담당 코치 (Coach.userId). 등록 시 담당 환자가 가장 적은 코치로 자동 배정
  coachId          String?
  /// 환자가 기록한 치료 중단 (담당 의사와 상의 후) — 지속 복용 분석·알림 중지에 사용
  stoppedAt        DateTime?   @db.Date
  stopReason       StopReason?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  coach  Coach?  @relation(fields: [coachId], references: [userId], onDelete: SetNull)

  @@index([clinicId])
  @@index([coachId])
  @@map("care_enrollments")
}

/// 투약 기록 (투약함 / 놓침)
model DoseLog {
  id        String         @id @default(cuid())
  userId    String
  takenAt   DateTime
  status    DoseStatus
  doseMg    Decimal        @db.Decimal(5, 2)
  /// 주사 부위 (먹는 약·놓침이면 없음)
  site      InjectionSite?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@map("dose_logs")
}

enum DoseStatus {
  TAKEN
  MISSED
}

enum InjectionSite {
  ABDOMEN_LEFT
  ABDOMEN_RIGHT
  THIGH_LEFT
  THIGH_RIGHT
  ARM_LEFT
  ARM_RIGHT
}

/// 연속혈당(CGM) 측정값. 사용자·시각당 1개 (중복 업로드는 무시)
model GlucoseReading {
  userId     String
  measuredAt DateTime
  mgdl       Int           @db.SmallInt
  source     GlucoseSource
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, measuredAt])
  @@map("glucose_readings")
}

/// CSV_UPLOAD = CGM 앱 내보내기 파일, CGM_PARTNER = 제조사 API 연동(향후), SAMPLE = 가상 데이터
enum GlucoseSource {
  CSV_UPLOAD
  CGM_PARTNER
  SAMPLE
}

/// 식사 기록. 사진은 저장하지 않고 추정·확인한 값만 저장한다.
model MealLog {
  id        String     @id @default(cuid())
  userId    String
  eatenAt   DateTime
  mealType  MealType
  /// MealItem[] { name, kcal?, carbsG?, proteinG? }
  items     Json
  kcal      Int?
  carbsG    Int?
  proteinG  Int?
  source    MealSource
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eatenAt])
  @@map("meal_logs")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealSource {
  MANUAL
  PHOTO_AI
}

/// 하루 1분 부작용 체크인 (사용자·날짜당 1개)
model SymptomCheckIn {
  id        String      @id @default(cuid())
  userId    String
  /// 한국 날짜
  date      DateTime    @db.Date
  /// { [SymptomCode]: 0..3 }
  symptoms  Json
  /// RedFlagCode[]
  redFlags  Json
  /// 오늘 식욕 0..10
  appetite  Int?        @db.SmallInt
  weightKg  Decimal?    @db.Decimal(5, 1)
  /// 규칙 엔진이 정한 안내 단계 (src/domain/glp1/symptoms.ts)
  triage    TriageLevel
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("symptom_check_ins")
}

enum TriageLevel {
  NONE
  SELF_CARE
  CONTACT_CLINIC
  URGENT
}

/// 위험 신호 (에스컬레이션). 의원 공유에 동의한 경우 의원 화면(향후)이 이 기록을 읽는다.
model CareAlert {
  id             String        @id @default(cuid())
  userId         String
  kind           CareAlertKind
  level          TriageLevel
  /// 같은 신호의 중복 기록 방지 키 (예: 해당 날짜)
  dedupeKey      String
  detectedAt     DateTime      @default(now())
  /// 의원·코치가 확인한 시각과 확인한 의료진 (ClinicStaff.userId)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  /// 코치 의뢰 사유 등 짧은 설명 (의원 공유 동의 시 의원 화면에 표시)
  detail         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, dedupeKey])
  @@index([userId, detectedAt])
  @@map("care_alerts")
}

enum CareAlertKind {
  SEVERE_SYMPTOM
  PERSISTENT_VOMITING
  LOW_GLUCOSE
  SEVERE_LOW_GLUCOSE
  MISSED_DOSES
  COACH_REFERRAL
}

/// AI 기능 사용 기록 (하루 사용 횟수 제한). 입력·결과 내용은 저장하지 않는다.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  /// 예: "meal-photo"
  feature   String
  ok        Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@map("ai_usages")
}

// ─────────────────────────────── 의사 대시보드 ───────────────────────────────
// docs/ARCHITECTURE.md §5.9. 의료진은 자기 의원에 연결되고 "의원 공유"에 동의한 환자만 본다.

/// 의원 소속 의료진 계정. 일반 가입으로는 만들 수 없고 운영 스크립트(npm run clinic:staff)로만 만든다.
model ClinicStaff {
  userId    String    @id
  clinicId  String
  role      StaffRole @default(DOCTOR)
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_staff")
}

enum StaffRole {
  DOCTOR
  NURSE
}

/// 내원 기록 — "지난 방문 이후" 리포트 기간의 기준
model ClinicVisit {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  visitedOn    DateTime @db.Date
  recordedById String?
  createdAt    DateTime @default(now())

  clinic  Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, patientId, visitedOn])
  @@index([patientId, visitedOn])
  @@map("clinic_visits")
}

/// 의료진의 환자 정보 열람·변경 감사 기록. 건강정보 값은 담지 않는다 (ID와 행동만).
model ClinicAccessLog {
  id          String   @id @default(cuid())
  staffUserId String
  clinicId    String
  patientId   String?
  /// 예: "view-list", "view-report", "ack-alert", "record-visit"
  action      String
  createdAt   DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([staffUserId, createdAt])
  @@map("clinic_access_logs")
}

// ─────────────────────────────── 코칭 센터 ───────────────────────────────
// docs/ARCHITECTURE.md §5.10. 코칭은 생활습관(식사·운동·생활)으로 한정한다. 약·진단은 담당 의사에게.

/// 코치(영양사·운동처방사) 계정. 운영 스크립트(npm run coach:add)로만 만든다.
model Coach {
  userId    String         @id
  specialty CoachSpecialty
  createdAt DateTime       @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients CareEnrollment[]

  @@map("coaches")
}

enum CoachSpecialty {
  NUTRITION
  EXERCISE
}

/// 환자 ↔ 코치 1:1 대화. 환자 단위 스레드 (코치가 바뀌어도 이어진다)
model CoachMessage {
  id                 String        @id @default(cuid())
  patientId          String
  /// 보낸 사람 (SYSTEM이면 없음)
  senderId           String?
  sender             MessageSender
  body               String
  /// 환자 메시지가 약·용량 문의로 보이는지 (규칙) — 코치 화면에 "담당 의사 안내" 표시
  medicationQuestion Boolean       @default(false)
  /// 상대방이 읽은 시각
  readAt             DateTime?
  createdAt          DateTime      @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("coach_messages")
}

enum MessageSender {
  PATIENT
  COACH
  SYSTEM
}

/// 코치의 환자 정보 열람·행동 감사 기록 (ID와 행동만)
model CoachAccessLog {
  id          String   @id @default(cuid())
  coachUserId String
  patientId   String?
  action      String
  createdAt   DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([coachUserId, createdAt])
  @@map("coach_access_logs")
}

enum StopReason {
  SIDE_EFFECTS
  COST
  GOAL_REACHED
  DOCTOR_ADVICE
  INCONVENIENCE
  OTHER
}

// ─────────────────────────────── 제약사 포털 ───────────────────────────────
// docs/ARCHITECTURE.md §5.11. "제약사 통계 제공"에 동의한 환자의 집계 통계만. 개별 의원 처방량·개별 환자 정보는 노출하지 않는다.

/// 제약사 (파트너). drugCodes = 지속 복용 분석을 볼 수 있는 자사 제품 (src/domain/glp1/drugs.ts 코드)
model PharmaOrg {
  id        String   @id @default(cuid())
  name      String   @unique
  drugCodes String[]
  createdAt DateTime @default(now())

  members PharmaMember[]

  @@map("pharma_orgs")
}

/// 제약사 포털 계정. 운영 스크립트(npm run pharma:add)로만 만든다.
model PharmaMember {
  userId    String   @id
  orgId     String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  PharmaOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("pharma_members")
}

/// 제약사 포털 열람 감사 기록 (환자·의원 ID는 담지 않는다)
model PharmaAccessLog {
  id           String   @id @default(cuid())
  memberUserId String
  orgId        String
  action       String
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("pharma_access_logs")
}
